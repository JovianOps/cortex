{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jovianops.github.io/cortex/schemas/cortex-lock.schema.json",
  "title": "Cortex Installation Lockfile (.cortex-lock.json v1.0.0)",
  "type": "object",
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "release_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["version", "dir", "installed_at", "files"],
        "properties": {
          "version": { "type": "string" },
          "dir": { "type": "string", "enum": ["skills", "premium-skills"] },
          "installed_at": { "type": "string", "format": "date-time" },
          "files": {
            "type": "object",
            "required": ["SKILL.md"],
            "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    }
  }
}
